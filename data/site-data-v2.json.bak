    {
      "id": "el_ρούχα",
      "lemma": "ρούχα",
      "lang": "el",
      "lang_label": "Greek",
      "pos": "NOUN",
      "freq": {
        "total": 65,
        "range": 53,
        "dp": 0,
        "pmw": 33.9,
        "by_subcorpus": {
          "ushmm_female": {
            "freq": 5,
            "range": 5,
            "total_files": 13,
            "dp": 0.5763,
            "pmw": 110.7
          },
          "ushmm_male": {
            "freq": 5,
            "range": 4,
            "total_files": 40,
