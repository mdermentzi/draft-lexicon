    {
      "id": "el_πόνο",
      "lemma": "πόνο",
      "lang": "el",
      "lang_label": "Greek",
      "pos": "NOUN",
      "freq": {
        "total": 1,
        "range": 1,
        "dp": 0,
        "pmw": 0.5,
        "by_subcorpus": {
