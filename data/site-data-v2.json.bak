      "kwic": [
        {
          "l": "Και περνούσαμε από κει. Με πήγαινε για να, το πρωί. Να δείτε πως τα λένε; Στη Βέροια έχει ένα μέρος που είναι δεν το",
          "n": "θυμάμαι",
          "r": ". Ανεβήκαμε το βράδυ, ε το απόγευμα και με λέει. Αφού πήραμε το ζαρζαβάτι, δεν το είδε ο Γερμανός, εγώ πήγα σε σπίτια",
          "f": "mog081_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "αυτά, μικρά. Και μπορέσαμε και μας βάλανε οι γονείς μας πια μες στη βάρκα και βγήκαμε στο… Βρομολιμνιώνα το λέγανε,",
          "n": "θυμάμαι",
          "r": ", αλλά τώρα ήτανε κανένα… κάνα λιμάνι, κανένας όρμος, που ’τανε… δεν ήταν πολύ εμφανής. Και βγήκαμε εκεί. Ο αδερφός",
          "f": "EL-26769.txt",
          "sc": "istorima"
        },
        {
          "l": "να κρατήσει και μέχρι 3 ημέρες, είχαμε του Αϊ-Γιαννιού και παίζανε λύρες, χορεύγανε, τραγουδούσανε. Τα κεράσματα",
          "n": "θυμάμαι",
          "r": ", η μαμά μου έκανε κουραμπιέδες και το πιοτό βέβαια ήτανε το απαραίτητο, είχαμε κρασί από το αμπέλι. Το κάναμε εμείς.",
          "f": "EL-10401.txt",
          "sc": "istorima"
        },
        {
          "l": "μεγάλη πείνα τα δύο πρώτα χρόνια. Δεν μπορούσαμε να βγούμε απ’ την Αθήνα, η επαρχία δεν το είχε αυτό το πρόβλημα και",
          "n": "θυμάμαι",
          "r": "τον πατέρα μου που έβαζε ξόβεργες και έπιανε σπουργίτια, περιστέρια, και μάλιστα εκείνη την εποχή είχαν εξαφανιστεί",
          "f": "EL-16338.txt",
          "sc": "istorima"
        },
        {
          "l": "εικόνα, όταν οι Γερμανοί τα σπάσανε με τους Ιταλούς, οι Ιταλοί, οι άνθρωποι τραβήξανε πάρα πολλά από τους Γερμανούς.",
          "n": "Θυμάμαι",
          "r": "είχε ξεμείνει ένας Ιταλός στην περιοχή μας, εκεί στην γειτονιά μας, ο Βιτόριο, ο οποίος για να βοηθήσει την",
          "f": "EL-12425.txt",
          "sc": "istorima"
        },
        {
          "l": "την ημέρα του Πολυτεχνείου πού ήσασταν; Ά.Θ. : Εδώ, στο Ηράκλειο ήμουνα και έλεγα ότι αν είχα λεφτά, θα πήγαινα.",
          "n": "Θυμάμαι",
          "r": ", όμως, την πρώτη επέτειο του Πολυτεχνείου που έτυχα να είμαι στην Αθήνα. Αυτή με συγκίνησε, με συγκλόνισε. Νόμιζα ότι",
          "f": "EL-11413.txt",
          "sc": "istorima"
        },
        {
          "l": "με τους Ιταλούς. Από την Ιταλοκρατία θυμάστε εσείς κάτι; Όχι, γεννήθηκα το '42, ο πόλεμος ήταν το '40, άρχισε. Δεν",
          "n": "θυμάμαι",
          "r": "τίποτα. Δεν μιλάω μόνο για την Κατοχή. Μιλάω και για γενικά, μέχρι την ένωση των Δωδεκανήσων με την Ελλάδα, αν",
          "f": "EL-23583.txt",
          "sc": "istorima"
        },
        {
          "l": "βέβαια καλυτέρευε. Αλλάζανε τα καθεστώτα, άλλαζε η κοινωνία, η ζωή καλυτέρευε. Έχετε κάτι άλλο να μας προσθέσετε; Δεν",
          "n": "θυμάμαι",
          "r": "κάτι. Σας ευχαριστώ πολύ για τη συνέντευξη που μου παραχωρήσατε και για τον χρόνο που μου διαθέσατε. Ελπίζω να σε",
          "f": "EL-24976.txt",
          "sc": "istorima"
        },
        {
          "l": "τη μέρα είναι ότι οι Γερμανοί σκοτώσανε έναν Μοσκώφ. Η οικογένεια Μοσκώφ ήταν πολύ γνωστή στη Θεσσαλονίκη κι αυτό που",
          "n": "θυμάμαι",
          "r": "είναι ότι βγήκε ο Μοσκώφ με το τσιγάρο στο μπαλκόνι, νομίσανε οι Γερμανοί ότι έκαμνε σινιάλο στ' αεροπλάνα και τον",
          "f": "mog046_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "Θυμάστε; Ήρθανε οι… Μετά τον πόλεμο; S.V. : Μετά, όταν έγινε ο πόλεμος. Θυμάστε; Τον πόλεμο… στην Κατοχή. Πώς δεν την",
          "n": "θυμάμαι",
          "r": ". Τα ‘ζησα, παιδί μου, τα ‘ζησα. S.V. : Θέλετε να μας πείτε λίγο τι θυμάστε; Ότι ο κόσμος πεινούσε πολύ, ότι πέθανε",
          "f": "EL-10637.txt",
          "sc": "istorima"
        },
        {
          "l": "μου. Δηλαδή, κάτσε. Πότε μιλάμε τώρα; Τι χρονολογία; Τώρα μιλάμε το ’44. Ήμουνα 6 χρονών. Και τι θυμάσαι; Θυμάμαι...",
          "n": "Θυμάμαι",
          "r": "και τους Γερμανούς που μας είχαν επιτάξει το σπίτι της γιαγιάς μου, και μας είχανε στριμώξει σε μια αχυρώνα εκεί που",
          "f": "EL-24307.txt",
          "sc": "istorima"
        },
        {
          "l": "είχα πρόβλημα υγείας, δεν είχε, απλώς τις παιδικές ασθένειες, η δεύτερή μου κόρη είχε πάθει στραβισμό στα μάτια και",
          "n": "θυμάμαι",
          "r": "τότε μας είπε ο γιατρός να πάτε πάνω στο Οφθαλμιατρείο Αθηνών, για να του κάνουν ασκήσεις του παιδιού, θέλει ασκήσεις",
          "f": "EL-12475.txt",
          "sc": "istorima"
        },
        {
          "l": "σας τι παιχνίδια παίζατε; Ιστορίες που να ακούγατε παιδί; Όλα τα θυμάμαι! Από την πρώτη στιγμή που πήγα στο σχολείο,",
          "n": "θυμάμαι",
          "r": "τα παιχνίδια μας, τα πεντόβολα, το κουτσό, τα αινίγματα. Το μυαλό μου δεν μου έχει φύγει. Έχω γεράσει, είμαι βέβαια",
          "f": "EL-20165.txt",
          "sc": "istorima"
        },
        {
          "l": "τι ήτανε δυσκολότερο για σένα, η γερμανική Κατοχή ή ο εμφύλιος; Ο εμφύλιος. Ο εμφύλιος. Πρώτα πρώτα τη, εγώ",
          "n": "θυμάμαι",
          "r": "τον πατέρα του, του αδερφού μου, του πατέρα μου τον αδερφό, που ταν στο πρώτο Αντάρτικο και τούτος ήταν χωροφύλακας",
          "f": "mog001_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "τακτοποιηθούνε κι αυτό, θα ήμουνα 13-14 χρονών. Και έπρεπε να πάω, στη δευτέρα τάξη έπρεπε να πάω ή στην τρίτη, δεν",
          "n": "θυμάμαι",
          "r": ". Γυμνασίου τώρα λες εκεί. Βρε, μικρή ήμουνα, σου λέω. Περίμενε, δεν λες 13-14; Κανονικά, πού θα έπρεπε να πας...",
          "f": "EL-15468.txt",
          "sc": "istorima"
        },
        {
          "l": "φώναζαν: «Πατέρα θέλουμε πίτα, να πεις στη μάνα πίτα». Λαχταρούσαν, κανένας δεν πήγαινε, μόνο πατέρας μου. Αυτά τα",
          "n": "θυμάμαι",
          "r": ", παιδί μου, και σ’ τα λέω. Κυρία Λόλα, πού ήταν αυτές οι φυλακές, θυμάστε; Η φυλακή είναι τώρα που είναι το",
          "f": "EL-24421.txt",
          "sc": "istorima"
        },
        {
          "l": "ας πούμε, Καστοριά κατεβήκανε. Κατεβήκαν Καστοριά. Τώρα, πόσο καιρό, δεν θυμάμαι πόσο καιρό. Ήμασταν και μικρά —δεν",
          "n": "θυμάμαι",
          "r": "πόσο καιρό ήτανε—, ας πούμε, στην Καστοριά. Να πήγαν για πάνω —δεν θυμάμαι για να έλεγαν και οι μεγαλύτεροι, ας",
          "f": "EL-21765.txt",
          "sc": "istorima"
        },
        {
          "l": "ήταν. Αλλά τότε κάνανε λάθη όμως και οι μεν και οι δε, και ο στρατός και οι αντάρτες. Εγώ βέβαια πιο καλά ας πούμε",
          "n": "θυμάμαι",
          "r": "ότι ζούσαμε με τους αντάρτες, γιατί πιο καλά μας σεβόντουσαν παρά ο στρατός. Πρώτα από όλα, ο στρατός, ριχνόντουσαν,",
          "f": "EL-14600.txt",
          "sc": "istorima"
        },
        {
          "l": "τα παιδιά μου, εμένα, τους, τα, τα, τους πάντες, τον άντρα μου. Α, πάρα πολύ, πάρα πολύ. Δηλαδή ο θάνατος. Εγώ δεν",
          "n": "θυμάμαι",
          "r": "τότε που μπήκανε οι Γερμανοί μέσα, να έχω χαρεί τη ζωή μου ποτέ. Γιατί πάντα οι εικόνες αυτές με, με ακολουθούν, με",
          "f": "mog062_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "πέρα. Και των έτυχενε η μπόρα που μας έτυχε και επαέ σκοτωθήκανε. Εσκοτώσανε ή τρεις ή τέσσερις Ροδακινιώτες, δεν",
          "n": "θυμάμαι",
          "r": "ακριβώς πόσοι. Υπήρχανε περισσότεροι Ροδακινιώτες σε άλλους καιρούς; Όχι. Αυτούς τους εκτοπίσανε απ' τα σπίτια των",
          "f": "mog004_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "Αθηνά, θα μας πείτε λίγα πράγματα για εσάς; Γιατί όχι, κορίτσι μου; Ό,τι θέλετε. Στην ηλικία που είμαι, αυτό που",
          "n": "θυμάμαι",
          "r": "θα σας το πω, όλα. Γεννήθηκα στον Σταυροπόταμο. Ο πατέρας μου έφυγε το ‘28 για την Αργεντινή και με άφησε στην κοιλιά",
          "f": "EL-24666.txt",
          "sc": "istorima"
        },
        {
          "l": "Δεν υπήρχε άλλος δρόμος. Όλο το χωριό από αυτόν τον δρόμο περνάγαμε, από το νεκροταφείο που περνάει ακόμα, και τι",
          "n": "θυμάμαι",
          "r": "; Θυμάμαι που πήγαμε στη Σκάλα. Μας πήρανε οι γονείς, κάτσε ήμουνα εγώ και τα δύο αγόρια, τα μεγαλύτερα από μένα.",
          "f": "EL-26574.txt",
          "sc": "istorima"
        },
        {
          "l": "Είχε έρθει απ' τη Γερμανία, είχε έρθει απ' τη Γερμανία ένας στη Θεσσαλονίκη που 'τανε και ανώτερος , Γερμανός. Δεν",
          "n": "θυμάμαι",
          "r": "τ' όνομά του παιδιά. Εσείς, ο Χρίστος μπορεί να το θυμάται. Ήρθε το '61 αυτός, ήταν ο Καραμανλής. Και είχε κρύψει",
          "f": "mog039_02_02_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "ήθελα να τους . Τα παιδάκια φωνάζανε, ήταν λίγο πιο μικρά όμως έτσι. Αλλά οι Γερμανοί, εγώ, μετά κατασκηνώσανε οι,",
          "n": "θυμάμαι",
          "r": "ότι κατασκηνώσαν στην πλατεία, ένα σύνταγμα δε μπορεί να ήταν, ένας λόχος μπορεί να ήτανε. Οι Ιταλοί. Οι Ιταλοί. Και",
          "f": "mog031_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "ήταν μερικοί καλοί. Ήρθε μέσα να δει: \"Ah, malato, malato?\". «Άρρωστος;». Έτσι το θυμάμαι αυτό, από καμιά λέξη τα",
          "n": "θυμάμαι",
          "r": ". «Ναι, ναι -είπαμε εμείς-, δεν μπορεί, δεν μπορεί. Εδώ η καρδιά», λέγαμε, τους δείχναμε με το αυτό. Ήταν και καλοί.",
          "f": "EL-21003.txt",
          "sc": "istorima"
        },
        {
          "l": "αυτοί είχαν έδρα στο Νεοχώρι και πήγε στο Νεοχώρι, τι έγινε; Γέρεψε, δε γέρεψε... Του ‘δωκε η μάνα μου παντελόνια,",
          "n": "θυμάμαι",
          "r": ", κάτι μπλούζες, κάτι πουκάμισα, ρούχα ν’ αλλάξει... Και έφυγε. «Άμα θα γίνω καλά, θα ‘ρθώ», της λέει της μάνας μου.",
          "f": "EL-20585.txt",
          "sc": "istorima"
        },
        {
          "l": "όμως. Και λίγο το πείσμα; Ήταν δυναμικοί άνθρωποι εδώ πέρα, έτσι δεν είναι; Ναι, ναι, βέβαια. Δυναμικοί άνθρωποι. Εγώ",
          "n": "θυμάμαι",
          "r": "όταν φτιάχναμε εδώ τα σπίτια, το αποφασίσαμε. Μας έστειλαν από την Αμερική κ αι αποφασίσαμε να κάνουμε τα σπίτια μας,",
          "f": "EL-14512.txt",
          "sc": "istorima"
        },
        {
          "l": "χαλίκια, 5-6 χρονών και έκανα τη «Τζιντζιολέτα». Τώρα, μετά δεν θυμάμαι –η αλήθεια του Θεού– πότε μπήκε και αυτό, δεν",
          "n": "θυμάμαι",
          "r": ". Πώς μετακινούνταν οι άνθρωποι μέσα και έξω απ’ την πόλη; Με τα λεωφορεία. Ναι, λεωφορεία υπήρχαν και υπήρχαν στην",
          "f": "EL-20390.txt",
          "sc": "istorima"
        },
        {
          "l": "πάρουν τα σκουλαρικάκια. Μήπως θυμάστε άλλα περιστατικά από τον Εμφύλιο πόλεμο; Ευαγγελία : Απ' τον Εμφύλιο πόλεμο",
          "n": "θυμάμαι",
          "r": ", όταν γινόταν οι μάχες, σε κάθε μάχη ερχότανε ο χωροφύλακας με το χαρτί κι έλεγε: «Εσύ κι ένα ζώο θα πας στη μάχη»,",
          "f": "EL-11173.txt",
          "sc": "istorima"
        },
        {
          "l": "Άσε και οι άλλες το ίδιο, ό,τι τους βολεύει. Έτσι. Τώρα είναι και οι συντάξεις. Πρώτα συντάξεις δεν υπήρχαν ε.",
          "n": "Θυμάμαι",
          "r": ", όταν δόθηκε η πρώτη σύνταξις επί Καραμανλή. Ξέρετε πόσο ήτανε; Δύο δραχμές. Ναι, ο συγχωρεμένος ο πατέρας μου είχεν",
          "f": "EL-10878.txt",
          "sc": "istorima"
        },
        {
          "l": "σας ηλικία στην Κάλυμνο; Λοιπόν, μια ιστορία θα σας πω από τα μικρά, παιδικά μου χρόνια. Μου έμεινε αξέχαστη και τη",
          "n": "θυμάμαι",
          "r": "ακόμα. Γεννήθηκα στην Κάλυμνο το 1931, 10 Οκτωβρίου, επί Ιταλοκρατίας και όταν έγινα οχτώ χρονών, με πήγε η μάνα μου",
          "f": "EL-17062.txt",
          "sc": "istorima"
        },
        {
          "l": "ότι «βγήκαν οι Ιταλοί στη Στεία!» και φωνάζαν στα χωριά ότι «έρχονται οι Ιταλοί!», το θυμάσαι, εκείνη η μέρα; Αν το",
          "n": "θυμάμαι",
          "r": "λέει! Απού μας είχε η μάνα μου στον Αϊ-Λια, στο μαγατζέ, τον κατέχεις, απού τονε πήρανε οι αδερφίδες οι δυο, εκειά",
          "f": "EL-20757.txt",
          "sc": "istorima"
        },
        {
          "l": "η γειτονιά εκεί είχαμε κάμει ένα πολύ μεγάλο καταφύγιο, κι είμαστε όλη η γειτονιά, 20-25 άτομα. Ένας Νεοζηλανδός –και",
          "n": "θυμάμαι",
          "r": ", παιδιά μου, και τον λέγανε David, αλήθεια– αυτός έμενε εκεί στη γειτονιά μας, στον καταυλισμό, μας γνώριζε, του",
          "f": "EL-10083.txt",
          "sc": "istorima"
        },
        {
          "l": "μας πέρασε απέναντι, στην Ιθάκη και πήγαμε στο Κιόνι, που είχαμε συγγενείς στο Κιόνι, και περάσαμε, καθίσαμε εκεί. Τι",
          "n": "θυμάμαι",
          "r": "; Ήμαστε… Πήγαμε σε ένα μοναστήρι επάνω, στον Αίνο, και βεβαίως μπήκαμε να ξεκουραστούμε, έτσι; Γιατί ούτε η μαμά μου",
          "f": "EL-23196.txt",
          "sc": "istorima"
        },
        {
          "l": "το πανηγύρι αυτό με το σεισμό τότε, κατάλαβες; Και αυτά, τι άλλο να ρωτήσεις; Σαν τι άλλο; Δε ξέρω τίποτα άλλο, αυτά",
          "n": "θυμάμαι",
          "r": ". Πώς ήτανε από το πρωί μέχρι το βράδυ, μια ημέρα στο χωριό πάνω, στα Πετρίλια; Πώς ήτανε από το πρωί μέχρι το βράδυ",
          "f": "EL-21032.txt",
          "sc": "istorima"
        },
        {
          "l": "Εκείνο πόσο κρατούσε, η γάστρα, για να φάμε πέντε άτομα; Σε μια μέρα το τρώγαμε. Πεινασμένα παιδιά. Άντε μωρέ, μην τα",
          "n": "θυμάμαι",
          "r": "και κλαίω. Έχεις κάτι άλλο που θέλεις να μας πεις, πριν κλείσουμε; Τι, μάνα μου, να σε πω; Ό,τι θες εσύ, δεν ξέρω.",
          "f": "EL-25022.txt",
          "sc": "istorima"
        },
        {
          "l": "τα θυμάμαι, αλλά τα θυμάμαι όμως, τα θυμάμαι, τα θυμάμαι. Δεν τα φέρνω να πούμε στο αυτό αλλά τα θυμάμαι, θυμάμαι,",
          "n": "θυμάμαι",
          "r": ". Θέλετε να προσθέσετε κάτι πριν κλείσουμε κ. Μιράντα; Όχι. Σας ευχαριστώ θερμά. Τώρα το χωριό, τώρα έγινε διαφορετικό",
          "f": "mog040_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "δηλαδή τι είχε γίνει; Τι, θυμάμαι όλα αυτά που μου έλεγε, καλά θυ. Αυτά τώρα απ' το τηλέφωνο ή εκείνη τη στιγμή; Α,",
          "n": "θυμάμαι",
          "r": "που είπα στον πατέρα μου: «Πατέρα επειδή τότε γίνονταν διάφορα μου 'χε πει ο Σταμάτης ο Λιάκος απ' την Ελευσίνα, και",
          "f": "mog023_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        }
      ],
