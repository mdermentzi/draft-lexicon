        {
          "w": "αντάρτης",
          "pos": "NOUN",
          "mi": 2.44,
          "t": 3.65,
          "ld": 8.36,
          "f": 20
        },
        {
          "w": "'46",
          "pos": "NOUN",
          "mi": 5.54,
          "t": 1.96,
