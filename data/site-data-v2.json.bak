          "n": "rifugio",
          "r": "che ci dava un'assistenza noi trovavamo un capitano medico capitano medico e dicevamo guardi ma noi la salute tante",
          "f": "Giacomo Moscato - Intervista a Giacomo Moscato.txt",
          "sc": "cdec_italy_male"
        }
