            "pmw": 839.5
          }
        }
      },
      "keyness": null,
      "collocations": [
        {
          "w": "κέντρο",
          "pos": "NOUN",
          "mi": 3.78,
          "t": 4.04,
          "ld": 8.66,
          "f": 19
        },
        {
          "w": "θεσσαλονίκη",
          "pos": "PROPN",
          "mi": 2.1,
          "t": 3.43,
          "ld": 8.39,
          "f": 20
        }
      ],
      "kwic": [
        {
          "l": "έμεινα στη μεγάλη παρανομία και άρχισε, όταν άρχισαν να λασκάρουνε λίγο τα μέτρα, μ' έπαιρνε ο άντρας μου, απ' την",
          "n": "Αθήνα",
          "r": "και μ' ανέβαζε στη Κηφισιά. Για να φάω λίγο, είχανε. Είχατε επαφή; Είχατε γνωριστεί με τον άντρα σας ήδη. Ναι, ναι,",
          "f": "mog018_02_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "Έχεις να μάθεις πάρα πολλά. Πάρα πολλά .Έχει μία ωραία μεταδοτικότητα και συγχρόνως κάνει μαθήματα δωρεάν στην",
          "n": "Αθήνα",
          "r": ". Και εμένα μου τη συνέστησε μια φίλη μου από την Αθήνα που την παρακολουθούσε. Και επειδή τώρα μπορώ να την ακούσω,",
          "f": "EL-22133.txt",
          "sc": "istorima"
        },
        {
          "l": "δεν τα πιστεύανε. Ερχόνταν… έπιασαν κι ερχόνταν και γαμπροί απ’ έξω. Δηλαδή οι άντρες των γυναικών που ήτανε στην",
          "n": "Αθήνα",
          "r": ". Γιατί πολλές απ’ την Ικαριά πηγαίνανε στα… Πώς το λένε; Πηγαίνανε στα ξένα για να κάνουν οι κοπέλες την περιουσίαν",
          "f": "EL-26769.txt",
          "sc": "istorima"
        },
        {
          "l": "από την Κατοχή στην Ελλάδα του Ελεύθερου Πανεπιστημίου του Βερολίνου, βρισκόμαστε σήμερα 19 Ιουνίου του 2017 στην",
          "n": "Αθήνα",
          "r": "με την Άλκη Ζέη. Καλησπέρα. Καλησπέρα σας. Να ξεκινήσουμε από κάποια βασικά βιογραφικά στοιχεία, όπως το πού και πότε",
          "f": "mog076_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "κι εμένα όλοι. Όλοι. Δεν είχα κανένα παράπονο με κανένα μου αδέρφι. Τα παιδιά σου που 'χανε το πρόβλημα τα πήγες στην",
          "n": "Αθήνα",
          "r": "τότε; Τι κάνατε με το πρόβλημα; Τ’ αγαπούσα τα παιδιά τ' αδέρφια μου. Τα παιδιά σου, τα δικά σου παιδιά τα πήγατε",
          "f": "EL-23866.txt",
          "sc": "istorima"
        },
        {
          "l": "πολύ καλός! Τον κρατήσατε καιρό στο σπίτι; Τον κρατήσαμε 6-7 μήνες, μετά είπανε να φύγουνε και ανεβήκανε στην",
          "n": "Αθήνα",
          "r": "να φύγουνε, αλλά μάθαμε μετά ότι τους πνίξανε, με το καράβι. Την ομάδα όλη αυτή που ήταν μαζί και ο Ιταλός; Όλοι,",
          "f": "EL-15334.txt",
          "sc": "istorima"
        },
        {
          "l": "που συμβαίνουν τόσα, δεν τ’ αλλάζω το αεροπλάνο. Είναι Θεού χαρά. Και το λεωφορείο που είχα έρθει κάνα δυο φορές από",
          "n": "Αθήνα",
          "r": "εδώ, πωπω, χάλια. Αυτά που λες. Εσείς πώς αισθανθήκατε όταν φύγατε από δω, από την πόλη, αφήσατε τους γονείς, τους",
          "f": "EL-11038.txt",
          "sc": "istorima"
        },
        {
          "l": "λέει, ήταν μακριά και όσο και να έχει κανείς πολλά παιδιά, θέλει να τα βλέπει. Και λέει: «Όχι, δεν στέλνω στην",
          "n": "Αθήνα",
          "r": "». Όσα κορίτσια είχαν πάει στην Αθήνα, είχαν αποξενωθεί… Δεν… Μπορείς να πηγαίνεις κάθε μέρα στην Αθήνα να τα βλέπεις;",
          "f": "EL-20629.txt",
          "sc": "istorima"
        },
        {
          "l": "ανωμαλίες, ο κόσμος άνω κάτω, ούτε δουλειά ούτε τίποτα. Ο πατέρας μου ήτανε ράφτης. Είχε πάρει δίπλωμα από την",
          "n": "Αθήνα",
          "r": "και έραβε τα καλύτερα κοστούμια. Όπως βλέπετε τώρα, τα κοστούμια, που είναι οι υπουργοί κι αυτά, τέτοιο στυλ έραβε ο",
          "f": "EL-17062.txt",
          "sc": "istorima"
        },
        {
          "l": "Μυτιλήνη. Απ' τις ακτές της Μικράς Ασίας περνούσαν στη Μυτιλήνη. Από τη Μυτιλήνη ήρθε Πειραιά, απ' το Πειραιά στην",
          "n": "Αθήνα",
          "r": "κι απ' την Αθήνα, αργότερα, πολύ σιγά, δεν μπορώ να θυμάμαι ή δεν το 'χω ακούσει πολλές φορές, μετά πόσο χρόνο ήρθε",
          "f": "EL-15026.txt",
          "sc": "istorima"
        },
        {
          "l": "ήταν πολλά, ήταν ο πόλεμος το ’40, πείνα, όλος ο κόσμος τυραννίστηκε, άλλοι πέθαιναν μες τον δρόμο. Πείνα. Απ’ την",
          "n": "Αθήνα",
          "r": "ερχόταν και πέθαιναν, για ένα κομμάτι ψωμί. Πέθαναν κόσμος, ξέρεις πόσοι πέθαναν στον δρόμο; Νηστικοί. Το ’41 ειδικά",
          "f": "EL-12191.txt",
          "sc": "istorima"
        },
        {
          "l": "Αυτά δεν τα στερηθήκαμε στη γιαγιά μου. Περισσότερα από σήμερα, λοιπόν, είχαμε. Κι όσοι ήταν στα χωριά ζήσανε. Στην",
          "n": "Αθήνα",
          "r": "πουλήσανε χρυσαφικά, πουλήσανε πράγματα ασημικά και τέτοια για να μπορέσουνε να πάρουνε ένα κομμάτι ψωμί και αυτά.",
          "f": "EL-16509.txt",
          "sc": "istorima"
        },
        {
          "l": "από πού ήταν, η καταγωγή του; Απ' τη Ζάκυνθο. Απ' τη Ζάκυνθο. Και είχε μεγαλώσει στον Πειραιά; Είχε μεγαλώσει στην",
          "n": "Αθήνα",
          "r": "μαζί με την θεια, την αδερφή του και στην Ιταλία είχε πάει, αλλά ήταν Ζακυνθινός. Η καταγωγή της μητέρας σας; Μέγαρα.",
          "f": "mog015_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "χωριά. Και στην Αθήνα πήγε ο άντρας μου με τον Μπαντουβά, τον Καρόλη, που δεν ξέρω αν τον έχεις ακούσει. Πήγαν στην",
          "n": "Αθήνα",
          "r": "και κάμανε έρανο για τον Άγιο Νεκτάριο. Γιατί θέλανε να τον χτίσουν; Ήτανε πρώτος Άγιος τότε, σαν είχε ακουστεί. Ήταν",
          "f": "EL-20495.txt",
          "sc": "istorima"
        },
        {
          "l": "έξω. Και πήραμε τον δρόμο για να βρούμε το τρένο, να περάσουμε τις χαλασμένες γραμμές και να πάρουμε το τρένο για",
          "n": "Αθήνα",
          "r": ". Λοιπόν όντως περπατήσαμε με τα λιγοστά μας ρούχα, πράγματα που είχαμε, δεν θυμάμαι δυο με τρία χιλιόμετρα, και όταν",
          "f": "EL-10141.txt",
          "sc": "istorima"
        },
        {
          "l": "τα πήγαμε σ' ένα φούρνο, καθώς πήγα εγώ με την αδερφή μου να τα πάρει, έμπλεξε το τσοκαράκι της, τότε είχε τραμ στην",
          "n": "Αθήνα",
          "r": ". Α ναι μπράβο. Στις γραμμές του τραμ, έπεσε μαζί με τα με το φαΐ και πήγε όλο πρόσωπό της και κάηκε και χάσαμε και τα",
          "f": "mog020_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "ήρθε εδώ κι εκείνος. Μετά από κάμποσα χρόνια, πόσα ήταν; Μπορεί να ήταν και πέντε, δε θυμάμαι τώρα. Και η ζωή στην",
          "n": "Αθήνα",
          "r": ", έτσι, πώς ήτανε η αλλαγή; Εμείς είχαμε περάσει δύσκολα, γιατί είχαμε συνεννοηθεί, είχε συνεννοηθεί δηλαδή ο πατέρας",
          "f": "EL-24808.txt",
          "sc": "istorima"
        },
        {
          "l": "να 'ρθείτε στην Αθήνα; Ήρθε στο χωριό ο ξάδερφός μου, μου λέει: «Θα σε πάρω για λίγες ημέρες». Με πήρε, ήρθαμε στην",
          "n": "Αθήνα",
          "r": ", μετά έμεινα εδώ, γνώριζε έναν φίλο του ο ξάδερφός μου, αρραβωνιάστηκα, παντρεύτηκα, έμεινα στην Αθήνα. Ήσασταν",
          "f": "EL-16586.txt",
          "sc": "istorima"
        },
        {
          "l": "Και. Μία διευκρίνηση, αυτή η θεία που, που μένατε μ' αυτή τη, μ' αυτή τη θεία; Που είπε να μην σας κρατήσω; Στην",
          "n": "Αθήνα",
          "r": "ακόμα; Στη, στην Αθήνα, τα Πατήσια. Ωραία. Και κατεβαίνω στα Τρίκαλα και τότε ήταν η μια, η ξαδέρφη μου αυτή που",
          "f": "mog071_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "Αθήνα με την οικογένειά του, κατακάτσανε εκειά, εκειά επόθανε. Αυτά. Ο Στέργιος μας πάλι επήγε κι εκάθουντονε στην",
          "n": "Αθήνα",
          "r": ", ύστερά 'ρθενε πάλι παέ κι αυτός κι εκάτσενε, επαέ πόθανε. Ετσά όλοι, αυτά. Τι κάνατε όταν ήσαστε μικρά με τα αδέρφια",
          "f": "EL-10091.txt",
          "sc": "istorima"
        },
        {
          "l": "ταχυδρόμος; Ά.Δ. : Επήγαινε Τήνο-Αθήνα. Μάζευε τα πράγματα και αυγά έπαιρνε, ό,τι παραγγελία είχε, τα έπαιρνε στην",
          "n": "Αθήνα",
          "r": "πακέτα όλα τα έπαιρνε στην Αθήνα. Και είχαν το «Τηνιακό Καφενείο» που λένε στην Αθήνα, δεν ξέρω, το ξέρεις; Nαι! Ά.Δ.",
          "f": "EL-11206.txt",
          "sc": "istorima"
        },
        {
          "l": "στην Αθήνα. Και έγινε αυτό που έγινε πια και μας είδανε γερούς. Αλλά όλοι φύγαν απ' τον Πειραιά και ερχόντουσαν στην",
          "n": "Αθήνα",
          "r": ". Πού να πάνε; Έξω καθόντουσαν οι άνθρωποι, απ' το φόβο. Απ' το φόβο, αλλά αυτό δεν το 'χω δει ποτέ, όσο χρονώ είμαι,",
          "f": "mog062_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "αριθμό και για γυναίκες τότε ήταν τα υφάσματα δεν ήταν τα έτοιμα Καρντεσίν, Μαροκέν, ωραιότατα του Ναθαναήλ απ’ την",
          "n": "Αθήνα",
          "r": ", γεμάτο, γεμάτο, φίσκα! Το καλοκαίρι έφερνε τα μεταξωτά μπροστά, τον χειμώνα πήγαινε τα μεταξωτά πίσω και έφερνε τα",
          "f": "EL-16156.txt",
          "sc": "istorima"
        },
        {
          "l": "στο πεζοδρόμιο. Την ίδια μέρα, άλλον τραπεζίτη. Τον σκοτώσαν στη γειτονιά του, αλλού. Δεν μπορώ να θυμηθώ. Εδώ, στην",
          "n": "Αθήνα",
          "r": ", στο Λυκαβηττό, υπάρχει ένας μικρός δρόμος, που φέρνει το όνομα ενός εξ αυτών. Κάποιοι το βάλανε. Ας είναι καλά που",
          "f": "EL-16310.txt",
          "sc": "istorima"
        },
        {
          "l": "χρήματα, δεν είχε τίποτα, πούλησε τη βέρα του για να μαζέψει χρήματα και μας έβαλε πάνω σε ένα φορτηγό που πήγαινε",
          "n": "Αθήνα",
          "r": "και ταξιδεύαμε δύο μέρες. Βράδυ βέβαια, φτάσαμε στην Αθήνα στο θείο μου. Εκεί μας μάζεψε. Ο θείος μου είχε κανονίσει",
          "f": "EL-13647.txt",
          "sc": "istorima"
        },
        {
          "l": "διασκεδάζετε όταν είχατε ελεύθερο χρόνο; Παίζατε, τρεχάτε σε κάποιο μέρος; Κοίταξε, αυτά, Ανδρέα μου, έγινε εδώ στην",
          "n": "Αθήνα",
          "r": "που ήρθαμε. Δηλαδή, το ‘55, ’56, ‘57 έπαιζα με τα παιδιά απ’ το... Με τα αδέρφια μου όχι. Το βράδυ, στην Αμφιθέα,",
          "f": "EL-27027.txt",
          "sc": "istorima"
        },
        {
          "l": "χειμώνα όχι, για να έχουνε να φάνε, γιατί η Κατοχή έφερε φτώχεια, έφερε πείνα, έφερε... Έφαγαν ως και λιοκόκκια στην",
          "n": "Αθήνα",
          "r": "οι άνθρωποι για να ζήσουνε, σε τέτοιο βαθμό. Ναι. Κατάλαβες; Είχανε καεί πολλά σπίτια εδώ στο χωριό; Στο χωριό ήτανε",
          "f": "EL-15468.txt",
          "sc": "istorima"
        },
        {
          "l": "και γινόντανε πολυκατοικίες κι αυτά. Και έχασε η περιοχή όλη αυτή την ωραιότητα που είχε. Σαν να ήτανε προάστιο της",
          "n": "Αθήνας",
          "r": ". Ήτανε πολύ ωραία περιοχή. Ο Άγιος Γεράσιμος δέσποζε από τα σπίτια μας. Ένα εκκλησάκι μικρό ήτανε, και μετά βάλαν",
          "f": "EL-24049.txt",
          "sc": "istorima"
        },
        {
          "l": "μου ο φοιτητής Ιατρικής. Κι έτσι πήγα στην Ιατρική Σχολή. Κι επειδή ιδρύθηκε κιόλας εκεί. Πιθανόν να πήγαινα και στην",
          "n": "Αθήνα",
          "r": ", αλλά δεν ξέρω αν θα έμπαινα κιόλας δίνοντας εξετάσεις. Ήρθε βολικά, μπήκα άνευ εξετάσεων και έτσι ήταν όλα καλά.",
          "f": "EL-10447.txt",
          "sc": "istorima"
        },
        {
          "l": "από ό,τι νομίζω ήταν και δεξιός κιόλας ο συγγενής του; Δεν ξέρω. Νομίζω. Για να τους σώσουν τη ζωή και τον πήγαν στην",
          "n": "Αθήνα",
          "r": "τον άνθρωπο, να φανταστείτε. Λοιπόν, έφτασαν εκεί και είπαν: «Όχι, εμείς δεν έχουμε σκοπό τέτοιο. Θα πας», λέει, «στη",
          "f": "EL-18267.txt",
          "sc": "istorima"
        },
        {
          "l": "μου ήμουνα τριών μηνώ έγκυος, ήρθε και το βρε και περπάταγε. Γιατί, παιδί μου, πολεμούσαμε να κάμομε το σπίτι στην",
          "n": "Αθήνα",
          "r": "και δυο χέρια εδουλεύανε, ναι. Και όταν υπήρχε… αρρώστησε με ζάχαρο σε μεγάλο βαθμό, χωρίς να ξέρει ότι είχε ζάχαρο,",
          "f": "EL-25726.txt",
          "sc": "istorima"
        },
        {
          "l": "συγκεντρώσει καταλόγους με τα ονόματα. Οπωσδήποτε, αφού δίναν παρών κάθε Σάββατο. Όχι μόνον στο Βόλο. Παντού και στην",
          "n": "Αθήνα",
          "r": "και παντού. Δίναν παρών. Αλλά απ' ό,τι μου λέτε υπήρχαν άνθρωποι που δεν είχαν διαβλέψει όπως ο πατέρας σας; Ναι,",
          "f": "mog049_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "στα 19, θα ήμουν 15-16 χρονών. Άρα μια δεκαετία ήσασταν σε σπίτια. Ναι, σπίτι και αυτά. Σας λέω, ήρθα στην",
          "n": "Αθήνα",
          "r": ". Εντωμεταξύ, είχα τα αδέρφια και ήταν τότε η κατάσταση δύσκολη, γιατί είχαν γίνει σε δυο παρατάξεις. Ήτανε το",
          "f": "EL-16058.txt",
          "sc": "istorima"
        },
        {
          "l": "μου. Εκεί μέναμε. Και όταν κηρύχθηκε ο πόλεμος, είπανε όλοι εκεί του σταθμού στη Σκύδρα, οι υπάλληλοι «Φεύγουμε, πάμε",
          "n": "Αθήνα",
          "r": ". Έρχονται οι Γερμανοί! Θα μας σκοτώσουν και πρέπει να φύγουμε!». Και έφυγαν όλοι οι υπάλληλοι από την Σκύδρα για να",
          "f": "EL-10528.txt",
          "sc": "istorima"
        },
        {
          "l": "μόνη μου, γιατί η μάνα μου μένανε στην εξοχή, ήτανε μόνο η πεθερά μου εδώ, τα παιδιά της και αυτά είχανε φύγει στην",
          "n": "Αθήνα",
          "r": ". Η πεθερά μου έφευγε το χειμώνα κι αυτή να πάει εκεί να τα βρει, δεν ήμουνα... δηλαδή δεν είχα από την οικογένειά μου",
          "f": "EL-20782.txt",
          "sc": "istorima"
        },
        {
          "l": "τον δικηγόρο. Είμαστε πολύ αγαπημένες, σαν αδελφές μεγαλώσαμε. Τώρα εκείνη μένει στην Αθήνα, λόγω… κλείστηκε στην",
          "n": "Αθήνα",
          "r": ", πήγε για γιατρούς και τηλεφωνιόμαστε συχνά. Εσείς είχατε πάει στην Αμοργό; Εγώ έχω πάει στην Αμοργό 4 φορές. Θέλω να",
          "f": "EL-13431.txt",
          "sc": "istorima"
        },
        {
          "l": "φαρμάκια. Πέθανε και η νυφαδιά μου από τη Γερμανία, 32 χρονών, από καρδιά. Σκοτώθηκε μια ανιψιά μου 19 χρονών στην",
          "n": "Αθήνα",
          "r": "από μηχανάκι. Στέκονταν στα φανάρια και πάει ένας κωλόγερος και το χτύπησε τ’ αυτοκίνητο και το πέταξε πέρα στον",
          "f": "EL-23961.txt",
          "sc": "istorima"
        },
        {
          "l": "τις λαγγίτες απάνω σε υψηλές πέτρες. Φτιάναμε λαγγίτες ίσα με να επιβιώσουμε στην κατοχή. Στην κατοχή πέθαναν στην",
          "n": "Αθήνα",
          "r": ", Θεσσαλονίκη πολύς κόσμος! Ναι, γιατί δεν είχαν να φάνε τίποτα! Η πείνα ή ο λιμός είναι πολύ δύσκολο και η δίψα ακόμα",
          "f": "EL-10500.txt",
          "sc": "istorima"
        },
        {
          "l": "Είμαι ερευνήτρια στο Istorima. Βρίσκομαι με την κυρία Μαρία Τριανταφυλλοπούλου. Εγώ βρίσκομαι στην Κυψέλη της",
          "n": "Αθήνας",
          "r": ". Η κυρία Τριανταφυλλοπούλου στη διεύθυνση εκεί στους Αμπελοκήπους και η συνέντευξή μας πραγματοποιείται τηλεφωνικά.",
          "f": "EL-13177.txt",
          "sc": "istorima"
        },
        {
          "l": "ξέρει καλά και ήθελε, αυτός είχε δυο αγοράκια μικρά, τεσσεράμισι ο Κωστάκης και δυόμισι ο Νικολάκης. Με πήρανε στην",
          "n": "Αθήνα",
          "r": "υπηρέτρια, babysitter. Ζήτησαν τη μάνα μου: «Να μας δώσεις ένα κορίτσι», λέει, όχι για να πληρωθώ, να με ταΐζουνε και",
          "f": "EL-25914.txt",
          "sc": "istorima"
        },
        {
          "l": "πεθάνει όλοι, μόνο μία αδερφή. Μάλιστα και πόσα αδέρφια ήσασταν; 5. 5, ωραία και οπότε αγροτικά. Αγροτικά. Και στην",
          "n": "Αθήνα",
          "r": "πώς βρεθήκατε; Είπαμε να αλλάξουμε ζωή, να ‘ρθούμε στην Αθήνα εδώ, ήρθαμε και δουλέψαμε και δημιουργήσαμε ό,τι",
          "f": "EL-24171.txt",
          "sc": "istorima"
        },
        {
          "l": "κοντά, είναι όμοια, είναι σαράντα πέντε χρονών τώρα, μπιτ, στα σαράντα έξι θα παν και τα δυο. Απέ και δώθε στην",
          "n": "Αθήνα",
          "r": "πέρα - δώθε, πέρα - δώθε. Μετά, μόνη μου κάμποσο καιρό. Ο άντρας μου στο καθαριστήριο με τον Πάνο που είχε το",
          "f": "EL-26580.txt",
          "sc": "istorima"
        },
        {
          "l": "Το ‘καψαν οι Γερμανοί. S.V. : Και τι δουλειές... Αυτό το σχολείο, πουθενά δεν υπήρχε, τέτοιο σχολείο! Ούτε στην",
          "n": "Αθήνα",
          "r": "ούτε πουθενά τέτοιο σχολείο που είχαμε εδώ. Με αίθουσες, με μεγάλα, με αυτά. Τα ‘χαν στείλει από την Αμερική χρήματα",
          "f": "EL-10815.txt",
          "sc": "istorima"
        },
        {
          "l": "«Έλα, ο Γιώργος μας έχει πέσει στον ασβέστη και τον πήγανε στην Αθήνα». Ο μπαμπάς του κι ένας θείος του πήγαν στην",
          "n": "Αθήνα",
          "r": ", το είδανε, είπανε δύο μερών με πολύ τριών μερών ζωή, δεν είχε ζωή. Μετά πήγα κι εγώ, εφτά χρόνια, τρία στο Αρεταίειο",
          "f": "EL-10083.txt",
          "sc": "istorima"
        }
      ],
