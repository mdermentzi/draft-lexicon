    {
      "id": "el_αγωνία",
      "lemma": "αγωνία",
      "lang": "el",
      "lang_label": "Greek",
      "pos": "NOUN",
      "freq": {
        "total": 51,
        "range": 34,
        "dp": 0,
        "pmw": 26.6,
        "by_subcorpus": {
          "ushmm_female": {
            "freq": 1,
