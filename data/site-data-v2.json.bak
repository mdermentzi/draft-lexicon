    {
      "id": "el_προστασία",
      "lemma": "προστασία",
      "lang": "el",
      "lang_label": "Greek",
      "pos": "NOUN",
      "freq": {
        "total": 24,
        "range": 18,
        "dp": 0,
        "pmw": 12.5,
        "by_subcorpus": {
          "ushmm_male": {
            "freq": 11,
            "range": 7,
            "total_files": 40,
            "dp": 0.7566,
            "pmw": 69.9
          },
          "istorima": {
            "freq": 11,
            "range": 9,
            "total_files": 181,
            "dp": 0.9461,
            "pmw": 9.4
          },
          "mog": {
            "freq": 2,
            "range": 2,
            "total_files": 27,
            "dp": 0.8817,
            "pmw": 5.6
          }
        }
      },
      "keyness": null,
      "collocations": [
        {
          "w": "ρόλος",
          "pos": "NOUN",
          "mi": 7.72,
          "t": 1.72,
          "ld": 9.6,
          "f": 3
        },
        {
          "w": "όλος",
          "pos": "ADJ",
          "mi": 1.23,
          "t": 0.99,
          "ld": 3.41,
          "f": 3
        }
      ],
      "kwic": [
        {
          "l": "Εμένα ο γιος μου ήρθε εδώ, τελείωσε τις σπουδές του, ήρθε εδώ και δούλευε δέκα χρόνια ήταν Προϊστάμενος στην Πολιτική",
          "n": "Προστασία",
          "r": "και τα υπόλοιπα είκοσι χρόνια δούλευε στο Συγκοινωνιών. Έβγαινε και στις εξετάσεις, έδινε διπλώματα και ύστερα άμα",
          "f": "EL-10500.txt",
          "sc": "istorima"
        },
        {
          "l": "τα έχω και σε κάποια φωτογραφία που τα έχω αγκαλιασμένα. Οι άλλοι ήταν πιο μεγάλοι, αλλά αυτά τα δύο τα είχα υπό την",
          "n": "προστασία",
          "r": "μου εγώ. Ήτανε και η Αριάδνη μικρή η καημένη. Και η Αριάδνη θα ‘τανε 7 χρονών και η Μαρία 9, αλλά ήταν ο Μήτσος",
          "f": "EL-10847.txt",
          "sc": "istorima"
        },
        {
          "l": "και πήρανε και κοπέλες και τις κατέβασαν μέχρι το Ηραίον. Τις πήρανε σαν λάφυρα. Όχι λάφυρα, πώς λέγεται; Για",
          "n": "προστασία",
          "r": "; Για να μην τους χτυπήσουν στο δρόμο οι αντάρτες. Ναι, ανθρώπινες ασπίδες, ξέρω ‘γω. Όχι, τους πήρανε σαν ομήρους.",
          "f": "EL-12348.txt",
          "sc": "istorima"
        },
        {
          "l": "Μπορείτε να μου πείτε περισσότερα για εκείνη τη μέρα; Εκείνη τη μέρα κάνει, επειδή η θεία μου, επειδή με είχε υπό την",
          "n": "προστασία",
          "r": "της κι ο θείος μου βέβαια, είχανε πει στη διευθύντρια να μη μ’ αφήνει όταν γίνεται βομβαρδισμός να φεύγω. Να μένω στο",
          "f": "EL-13032.txt",
          "sc": "istorima"
        },
        {
          "l": "ο πατέρας μου ήταν ήδη στη φυλακή, ήρθα εδώ με τη μάνα μου και την αδερφή μου και μέναμε σαν πρόσφυγες, είχαμε την",
          "n": "προστασία",
          "r": "βέβαια των προσφύγων. Υπήρχε προστασία προσφύγων τότε. Μέχρι το ΄45 που γύρισε ο πατέρας μου και μετά το ΄46",
          "f": "EL-14993.txt",
          "sc": "istorima"
        },
        {
          "l": "εδώ με τη μάνα μου και την αδερφή μου και μέναμε σαν πρόσφυγες, είχαμε την προστασία βέβαια των προσφύγων. Υπήρχε",
          "n": "προστασία",
          "r": "προσφύγων τότε. Μέχρι το ΄45 που γύρισε ο πατέρας μου και μετά το ΄46 ξαναγυρίσαμε πίσω στα Σέρρας. Και ο πατέρας σας",
          "f": "EL-14993.txt",
          "sc": "istorima"
        },
        {
          "l": "ας πούμε, βοηθάνε το δέρμα να μείνει άσπρο, γιατί φαντάσου ότι τότε είχανε μια μπολίδα, δηλαδή τη μαντίλα αυτή για",
          "n": "προστασία",
          "r": "από τον ήλιο και τίποτα άλλο. Εγώ έχω φακίδες, βλέπετε, και τώρα έχουνε λιγοστέψει, σε σχέση με το παρελθόν. Η γιαγιά",
          "f": "EL-18907.txt",
          "sc": "istorima"
        },
        {
          "l": "πειράξει το παιδί. Και, φυσικά, ει δυνατόν, όσες είχαν τη δυνατότητα, κοιμόντουσαν χωριστά απ’ τους άντρες. Ήταν μία",
          "n": "προστασία",
          "r": ", για να μπορεί η γυναίκα να ξεκουραστεί μετά από 9 μήνες και να συνεχίσει με ένα μωρό, που θα το τραβούσε μαζί της,",
          "f": "EL-18907.txt",
          "sc": "istorima"
        },
        {
          "l": "εδικαιούτο περιουσία, έτσι; Πήρε, λοιπόν, την κόρη της... Όταν, λοιπόν, πέθανε ο άντρας της, αυτομάτως υπήγετο στην",
          "n": "προστασία",
          "r": "του τσάρου και πήγε, πήρε την κόρη της, η οποία μόλις είχε τελειώσει, η γιαγιά μου, τη Σορβόννη, Φιλολογία, την πήρε",
          "f": "EL-23196.txt",
          "sc": "istorima"
        },
        {
          "l": "μ’ άφηνε. Ήθελε να μ’ έχει εκεί παρέα. Φοβόταν να μη με γελάσει κανένας, να μην πάθω τίποτα, καταλαβαίνεις, ήμαν στην",
          "n": "προστασία",
          "r": "αυτουνού. Και μετά στο Λιανοκλάδι πήγαμε σε μια παλιοκουζίνα, όπως είναι αυτή, ούτε παράθυρο, ούτε πόρτα. Τσιμέντο",
          "f": "EL-23411.txt",
          "sc": "istorima"
        },
        {
          "l": "hamsin, hamsin, και είναι άμμος κινούμενη, δηλαδή τρέχει η άμμος πυκνή. Δηλαδή δεν μπορείς να βγεις έξω, χωρίς γυαλιά",
          "n": "προστασίας",
          "r": "θα στραβωθείς. Και σε αμμοβολούσε δηλαδή το… στο δέρμα σου. Δεν μπορούσες να βγεις, τέλος πάντων, έξω. Και δεν μπορώ",
          "f": "EL-27062.txt",
          "sc": "istorima"
        },
        {
          "l": "σκεφτήκαμε σαν παιδάκια ποτέ. Δηλαδή κι είναι φοβερό πράγμα ο άνθρωπος να μην έχει παιδική ηλικία. Αυτό, δεν είχαμε",
          "n": "προστασία",
          "r": ", δεν είχαμε καμία χαρά. Ήταν πράγματα φοβερά. Ναι. Οι αριστεροί σε τι διαφωνούσαν; Διαφωνούσαν να γίνει και των",
          "f": "mog039_02_02_tr_gre_2025_07_22.txt",
          "sc": "mog"
        },
        {
          "l": "μορφωμένος και ο πιο πολιτικός. Εννοείτε ότι είχε και ιδεολογική σχέση με την Αντίσταση, δεν είχε απλώς για λόγους",
          "n": "προστασίας",
          "r": "; Όχι. Όχι, αλλά αυτός έβλεπε την κατάσταση όπως ήταν και επειδή ήταν και πιο μορφωμένος, έμπαινε πιο μέσα και ήξερε",
          "f": "mog086_01_01_tr_gre_2025_07_22.txt",
          "sc": "mog"
        }
      ],
